{
	Tools = ordered() {
		TG_AN_InOutTest_CTRL_v0_1 = AlphaDivide {
			NameSet = true,
			Inputs = {
				AnimationStart = Input { Value = 30, },
				InLength = Input { Value = 20, },
				InFade = Input { Value = 1, },
				InScale = Input { Value = 1, },
				InStartScale = Input { Value = 0.75, },
				OutStart = Input { Value = 240, },
				OutLength = Input { Value = 20, },
				OutFade = Input { Value = 1, },
				OutScale = Input { Value = 1, },
				OutEndScale = Input { Value = 0.75, },
				MasterOpacity = Input { Value = 1, },
			},
			ViewInfo = OperatorInfo { Pos = { -660, -610 } },
			UserControls = ordered() {
				AnimationTab = { LINKS_Name = "ANIMATION", LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_DropDownButton = true, LBLC_NumInputs = 11, },
				AnimationStart = { LINKS_Name = "Start Frame", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 30, INP_Integer = true, INP_MinScale = 0, INP_MaxScale = 300, },
				InLength = { LINKS_Name = "IN Length", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 20, INP_Integer = true, INP_MinScale = 1, INP_MaxScale = 120, },
				InFade = { LINKS_Name = "IN Fade", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				InScale = { LINKS_Name = "IN Scale", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				InStartScale = { LINKS_Name = "IN Start Scale", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.75, INP_MinScale = 0, INP_MaxScale = 1, },
				OutStart = { LINKS_Name = "OUT Start Frame", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 240, INP_Integer = true, INP_MinScale = 0, INP_MaxScale = 300, },
				OutLength = { LINKS_Name = "OUT Length", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 20, INP_Integer = true, INP_MinScale = 1, INP_MaxScale = 120, },
				OutFade = { LINKS_Name = "OUT Fade", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				OutScale = { LINKS_Name = "OUT Scale", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				OutEndScale = { LINKS_Name = "OUT End Scale", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.75, INP_MinScale = 0, INP_MaxScale = 1, },
				MasterOpacity = { LINKS_Name = "Master Opacity", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1, },
			},
		},
		TG_AN_InOutTest_Input_v0_1 = PipeRouter {
			ViewInfo = PipeRouterInfo { Pos = { -660, -500 } },
		},
		TG_AN_InOutTest_Transform_v0_1 = Transform {
			Inputs = {
				Size = Input {
					Expression = "iif(time < TG_AN_InOutTest_CTRL_v0_1.AnimationStart, TG_AN_InOutTest_CTRL_v0_1.InStartScale, iif(time < TG_AN_InOutTest_CTRL_v0_1.AnimationStart + max(TG_AN_InOutTest_CTRL_v0_1.InLength, 1), iif(TG_AN_InOutTest_CTRL_v0_1.InScale == 1, TG_AN_InOutTest_CTRL_v0_1.InStartScale + (1 - TG_AN_InOutTest_CTRL_v0_1.InStartScale) * pow(min(max((time - TG_AN_InOutTest_CTRL_v0_1.AnimationStart) / max(TG_AN_InOutTest_CTRL_v0_1.InLength, 1), 0), 1), 2) * (3 - 2 * min(max((time - TG_AN_InOutTest_CTRL_v0_1.AnimationStart) / max(TG_AN_InOutTest_CTRL_v0_1.InLength, 1), 0), 1)), 1), iif(time < TG_AN_InOutTest_CTRL_v0_1.OutStart, 1, iif(time < TG_AN_InOutTest_CTRL_v0_1.OutStart + max(TG_AN_InOutTest_CTRL_v0_1.OutLength, 1), iif(TG_AN_InOutTest_CTRL_v0_1.OutScale == 1, 1 - (1 - TG_AN_InOutTest_CTRL_v0_1.OutEndScale) * pow(min(max((time - TG_AN_InOutTest_CTRL_v0_1.OutStart) / max(TG_AN_InOutTest_CTRL_v0_1.OutLength, 1), 0), 1), 2) * (3 - 2 * min(max((time - TG_AN_InOutTest_CTRL_v0_1.OutStart) / max(TG_AN_InOutTest_CTRL_v0_1.OutLength, 1), 0), 1)), 1), TG_AN_InOutTest_CTRL_v0_1.OutEndScale))))",
				},
				Input = Input { SourceOp = "TG_AN_InOutTest_Input_v0_1", Source = "Output", },
			},
			ViewInfo = OperatorInfo { Pos = { -440, -500 } },
		},
		TG_AN_InOutTest_Canvas_v0_1 = Background {
			Inputs = {
				Width = Input { Expression = "comp:GetPrefs(\"Comp.FrameFormat.Width\")", },
				Height = Input { Expression = "comp:GetPrefs(\"Comp.FrameFormat.Height\")", },
				TopLeftAlpha = Input { Value = 0, },
			},
			ViewInfo = OperatorInfo { Pos = { -440, -610 } },
		},
		TG_AN_InOutTest_v0_1 = Merge {
			Inputs = {
				Background = Input { SourceOp = "TG_AN_InOutTest_Canvas_v0_1", Source = "Output", },
				Foreground = Input { SourceOp = "TG_AN_InOutTest_Transform_v0_1", Source = "Output", },
				Blend = Input {
					Expression = "TG_AN_InOutTest_CTRL_v0_1.MasterOpacity * iif(time < TG_AN_InOutTest_CTRL_v0_1.AnimationStart, 0, iif(time < TG_AN_InOutTest_CTRL_v0_1.AnimationStart + max(TG_AN_InOutTest_CTRL_v0_1.InLength, 1), iif(TG_AN_InOutTest_CTRL_v0_1.InFade == 1, pow(min(max((time - TG_AN_InOutTest_CTRL_v0_1.AnimationStart) / max(TG_AN_InOutTest_CTRL_v0_1.InLength, 1), 0), 1), 2) * (3 - 2 * min(max((time - TG_AN_InOutTest_CTRL_v0_1.AnimationStart) / max(TG_AN_InOutTest_CTRL_v0_1.InLength, 1), 0), 1)), 1), iif(time < TG_AN_InOutTest_CTRL_v0_1.OutStart, 1, iif(time < TG_AN_InOutTest_CTRL_v0_1.OutStart + max(TG_AN_InOutTest_CTRL_v0_1.OutLength, 1), iif(TG_AN_InOutTest_CTRL_v0_1.OutFade == 1, 1 - pow(min(max((time - TG_AN_InOutTest_CTRL_v0_1.OutStart) / max(TG_AN_InOutTest_CTRL_v0_1.OutLength, 1), 0), 1), 2) * (3 - 2 * min(max((time - TG_AN_InOutTest_CTRL_v0_1.OutStart) / max(TG_AN_InOutTest_CTRL_v0_1.OutLength, 1), 0), 1)), 1), 0))))",
				},
				PerformDepthMerge = Input { Value = 0, },
			},
			ViewInfo = OperatorInfo { Pos = { -220, -500 } },
			Colors = { TileColor = { R = 0.372549019607843, G = 0.6, B = 0.125490196078431 }, },
		},
	}
}
